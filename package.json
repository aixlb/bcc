{
  "name": "bcc",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aixlb/bcc.git"
  },
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "description": "XLB Storyboard - 包拆拆 视频转剧本/分镜工具",
  "productName": "XLB Storyboard",
  "main": "out/main/index.js",
  "type": "module",
  "bin": {
    "bcc": "out/cli/index.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "gen:masters": "node scripts/gen-masters.mjs",
    "build:publish": "node scripts/build-publish.mjs",
    "publish:skill": "node scripts/publish-skill.mjs",
    "publish:app": "node scripts/publish-app.mjs",
    "cli": "node out/cli/index.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac && npm run smoke:mac-release",
    "dist:mas": "npm run build && electron-builder --mac mas",
    "smoke:mac-release": "node scripts/smoke-mac-release.mjs",
    "smoke:win-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-win-release.ps1",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run build:cli && npm run build:skill",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.xlbstoryboard.app",
    "productName": "XLB Storyboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "mas": {
      "category": "public.app-category.video",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false,
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  },
  "copyright": "© 2026 XLB Storyboard",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^2.3.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.13.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tar": "^7.5.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.9"
  }
}
